<?xml version="1.0" encoding="UTF-8"?>
<c3p0-config>
	<default-config>
		<property name="driverClass">org.opengauss.Driver</property>
		<property name="jdbcUrl">jdbc:opengauss://127.0.0.1:5432/ssms</property>
		<property name="user">gaussdb</property>
		<property name="initialPoolSize">1</property>
		<property name="minPoolSize">1</property>
		<property name="maxPoolSize">10</property>
		<property name="checkoutTimeout">10000</property>
		<property name="acquireRetryAttempts">3</property>
		<property name="breakAfterAcquireFailure">true</property>
		<property name="preferredTestQuery">SELECT 1</property>
		<property name="testConnectionOnCheckout">true</property>
	</default-config>
</c3p0-config>

